# 셸에서 export 후 실행 (원본 앱은 .env를 자동으로 읽지 않습니다).
MODEL_SOURCE=local
LOADING_MODE=lazy
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# 공통 계약: diesel-weekly-v2, 날짜 포함 120일 입력·1~4주 평균가 출력
# 배포: 1주 RMSE<=50, 4주 각각 <naive, 4주 평균 <=Production
# 드리프트: 최근 28개 기준일의 1주 RMSE>같은 기간 naive (AIOps 구현 TODO)
# 재학습: 최근 627행, 365일 학습·독립 90일 검증, scaler 재fit 금지
