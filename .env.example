# 셸에서 export 후 실행 (원본 앱은 .env를 자동으로 읽지 않습니다).
# 대시보드 초기 학습·배포 및 AIOps 자동 교체
MODEL_SOURCE=mlflow
LOADING_MODE=lazy
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# 공통 계약: diesel-weekly-v2, 날짜 포함 120일 입력·1~4주 평균가 출력
# 배포: 1주 RMSE<=50, 4주 각각 <naive, 4주 평균 <=Production
# 드리프트: 최근 28개 기준일의 1주 RMSE>max(같은 기간 naive, 10원/L)
# 재학습: 최근 627행, 365일 학습·독립 90일 검증, scaler 재fit 금지
# AIOps (자동 교체는 MODEL_SOURCE=mlflow에서만)
AIOPS_ALERT_WEBHOOK_URL=
AIOPS_ALERT_FILE=logs/alerts.jsonl
AIOPS_ALERT_TIMEOUT=5
AIOPS_ALERT_DEDUP_SECONDS=3600
RETRAIN_COOLDOWN_SECONDS=600
DIESEL_DATA_CSV=data/processed/diesel_features_2008_spliced.csv
# fine-tuning 강도 (기본값 유지 권장, 근거 docs/evidence/11)
# FINE_TUNE_LR=1e-4
# FINE_TUNE_EPOCHS=10
